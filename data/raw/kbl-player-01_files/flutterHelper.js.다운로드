async function flutter(data) {
    if (!isReadyFlutter()) return;

    if (data.handler === 'appLink') {
        if (data.url && !data.url.startsWith('http')) {
            data.url = window.location.protocol + '//' + window.location.host + data.url;
        }
    }

    if (data.handler === 'download') {
        if (data.type == 'file') {
            if (data.url.split('.').pop() === 'html') {
                await flutter({handler: 'externalLink', url: data.url});
                return;
            }
        } else if (data.type == 'blob') {
            data.data = await flutterBlobToBase64(data.data);
        }
    }

    window.flutter_inappwebview.callHandler('bridge', data)
        .then(function(result) {
            if (data.callback) {
                data.callback(result);
            }
        })
        .catch(function(error) {
            console.error('Error calling Flutter handler:', error);
        });
}

function isReadyFlutter() {
    return !!window.flutter_inappwebview && !!window.flutter_inappwebview.callHandler;
}

// don't remove. app call this function.
function clearLocalStorageInApp() {
    if(isReadyFlutter()) {
        localStorage.removeItem('loginStorage')
        localStorage.removeItem('alertStore')
        localStorage.removeItem('articleStore')
        localStorage.removeItem('auctionStore')
        localStorage.removeItem('eventStore')
        localStorage.removeItem('mediaStore')
        localStorage.removeItem('myTicketStore')
        localStorage.removeItem('sideStorage')
        localStorage.removeItem('ticketStore')
        localStorage.removeItem('communityStore')
        localStorage.removeItem('directStore')
        localStorage.removeItem('reporterStore')
    }
}

// don't remove. app call this function.
function setIsLoginInApp(isLogin) {
    if(isReadyFlutter()) {
        const loginStorage = localStorage.getItem('loginStorage');

        if (loginStorage) {
            const loginObject = JSON.parse(loginStorage);
            loginObject.state.isLogin = isLogin;
            const updatedLoginStorage = JSON.stringify(loginObject);
            localStorage.setItem('loginStorage', updatedLoginStorage);
            console.log('Updated localStorage:', updatedLoginStorage);
        } else {
            console.error('No loginStorage found in localStorage');
        }
    }
}

async function flutterBlobToBase64(blob) {
    return new Promise((resolve, reject) => {
        console.log('Blob data:', blob);

        const reader = new FileReader();
        reader.onloadend = function(event) {
            const base64String = event.target.result.split(',')[1];
            console.log('blob:'+base64String);
            resolve(base64String);
        };
        reader.onerror = reject;
        reader.readAsDataURL(blob);
    });
}